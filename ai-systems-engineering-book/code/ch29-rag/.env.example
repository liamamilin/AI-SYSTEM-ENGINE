# OpenAI-compatible endpoint (cloud providers only; local Ollama path uses native API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b-mlx  # fast model; use qwen3.8:27b-mlx for quality runs
LLM_PROVIDER=ollama       # ollama | openai

# Ollama native endpoint (generation with think=false + bge-m3 embeddings)
OLLAMA_BASE=http://localhost:11434
EMBED_MODEL=bge-m3
